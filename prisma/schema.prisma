// `importFileExtension` e `moduleFormat` fixos: sem eles o Prisma deduz ambos do tsconfig.json (com
// `moduleResolution: "bundler"` gera imports sem extensao; com `allowImportingTsExtensions` ou
// `rewriteRelativeImportExtensions`, gera `.ts`). Com `.js` explicito, o client funciona no tsx, no
// Vitest e no `tsc --noEmit` (que resolvem `.js` para o `.ts`) e sai no dist ja pronto para o Node.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Empresa (tenant). Todo usuario pertence a uma empresa e as consultas sao sempre escopadas por `companyId`.
model Company {
  id        String    @id @default(uuid(7))
  name      String
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users User[]

  @@index([deletedAt])
  @@map("companies")
}

/// Usuario autenticavel. Exclusao e logica (`deletedAt`); `email` continua unico mesmo apos exclusao.
model User {
  id        String    @id @default(uuid(7))
  companyId String
  name      String
  email     String    @unique
  password  String
  image     String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([deletedAt])
  @@map("users")
}
