// `importFileExtension` e `moduleFormat` fixos: sem eles o Prisma deduz ambos do tsconfig.json (com
// `moduleResolution: "bundler"` gera imports sem extensao; com `allowImportingTsExtensions` ou
// `rewriteRelativeImportExtensions`, gera `.ts`). Com `.js` explicito, o client funciona no tsx, no
// Vitest e no `tsc --noEmit` (que resolvem `.js` para o `.ts`) e sai no dist ja pronto para o Node.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Empresa (tenant). Todo usuario pertence a uma empresa e as consultas sao sempre escopadas por `companyId`.
model Company {
  id        String    @id @default(uuid(7))
  name      String
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users         User[]
  roles         Role[]
  systemConfigs SystemConfig[]
  auditLogs     AuditLog[]

  @@index([deletedAt])
  @@map("companies")
}

/// Usuario autenticavel. Exclusao e logica (`deletedAt`); `email` continua unico mesmo apos exclusao.
/// `idleTimeoutMinutes` e o tempo de inatividade proprio do usuario; null herda `security.idleTimeoutMinutes` da empresa.
/// `lastLoginAt` e a ultima abertura de sessao (null = nunca acessou), gravada pelo login bem-sucedido e pelo register,
/// sempre por `recordLastLoginService`, na transacao do registro de auditoria, sem mover o `updatedAt` (que reflete so
/// edicao de cadastro). Sem indice: e ordenacao opcional da lista, como `name` e `createdAt`, que ja filtra por `companyId`.
model User {
  id                 String    @id @default(uuid(7))
  companyId          String
  name               String
  email              String    @unique
  password           String
  image              String?
  phone              String?
  isActive           Boolean   @default(true)
  idleTimeoutMinutes Int?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  company   Company    @relation(fields: [companyId], references: [id])
  userRoles UserRole[]
  auditLogs AuditLog[]

  @@index([companyId])
  @@index([deletedAt])
  @@map("users")
}

/// Permissao do catalogo, global (igual para todas as empresas). A fonte e `src/modules/permissions/permission.catalog.ts`,
/// sincronizada por `syncPermissionCatalogService`; nao se cria permissao pela API. `name` e a chave estavel usada no
/// codigo (`backoffice.users.read`); `module`, `groupLabel`, `action`, `label` e `sortOrder` alimentam a tela de cargos.
model Permission {
  id         String   @id @default(uuid(7))
  name       String   @unique
  module     String
  groupLabel String
  action     String
  label      String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Cargo de uma empresa: conjunto de permissoes atribuido a usuarios. Toda empresa tem o cargo de sistema
/// `Administrador` (`isSystem`), com o catalogo inteiro. `name` e unico na empresa mesmo apos exclusao logica.
/// O indice unico `[companyId, name]` tambem atende as consultas por `companyId`.
model Role {
  id          String    @id @default(uuid(7))
  companyId   String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company         Company          @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, name])
  @@index([deletedAt])
  @@map("roles")
}

/// Permissao concedida a um cargo. O indice unico `[roleId, permissionId]` tambem atende as consultas por `roleId`.
model RolePermission {
  id           String   @id @default(uuid(7))
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Cargo atribuido a um usuario (um usuario pode ter varios). As permissoes efetivas sao a uniao dos cargos nao
/// excluidos. O indice unico `[userId, roleId]` tambem atende as consultas por `userId`.
model UserRole {
  id        String   @id @default(uuid(7))
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Valor de configuracao de sistema gravado por uma empresa. As definicoes (rotulo, tipo, padrao, regra) vivem no codigo,
/// em `src/modules/systemConfigs/systemConfig.catalog.ts`; aqui fica so o valor que a empresa gravou, sempre como texto.
/// Sem linha, vale o padrao do catalogo. O indice unico `[companyId, key]` tambem atende as consultas por `companyId`.
model SystemConfig {
  id        String   @id @default(uuid(7))
  companyId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@map("system_configs")
}

/// Agrupador funcional da trilha de auditoria. Rotulos pt-BR em `src/modules/audit/audit.catalog.ts`.
enum AuditModule {
  USERS
  SECURITY
  SETTINGS
}

/// Acao registrada na trilha de auditoria. Rotulos pt-BR em `src/modules/audit/audit.catalog.ts`. `export` e a
/// retirada de dados por uma rota de exportacao (`recordExportAuditService`), com formato e filtros no `after`.
enum AuditAction {
  create
  update
  delete
  statusChange
  login
  export
}

/// Registro da trilha de auditoria: uma mudanca confirmada (ou um login, ou uma exportacao) numa empresa, gravada na
/// mesma transacao da mutacao por `recordAuditService`. So leitura pela API. `entity` e o nome do model afetado
/// (`User`, `Role`, `SystemConfig`) e `entityId` o id dele, sem FK (polimorfico; a chave, no caso de configuracao).
/// `before`/`after` guardam so valores primitivos, com os dados pessoais (decisao do dono; prazo e anonimizacao na
/// retencao) e nunca segredo; `description` nomeia o registro afetado. O nome do autor vem do relacionamento com
/// `User`, nunca de copia aqui. `requestId`, `ip` e `userAgent` vem do contexto da requisicao e nao saem pela API.
/// O indice `[companyId, createdAt]` tambem atende as consultas por `companyId`; o `[companyId, entity, entityId]`
/// atende o historico de um registro (aba "Atividade": `entity` + `entityId`, sem `module`), sem depender de skip scan.
///
/// Busca por conteudo (`search` da lista, `ILIKE '%termo%'`): indices GIN trigram (`pg_trgm`) em `description` e
/// `entityId` (modelados abaixo) e nos valores de `before`/`after`, pela expressao
/// `(jsonb_path_query_array(<coluna>, '$.* ? (@ != null)')::text)`: so os valores do JSON, sem o nome das chaves nem
/// os nulos (buscar "email" nao traz todo evento de usuario). Esses dois, `audit_logs_before_values_trgm_idx` e
/// `audit_logs_after_values_trgm_idx`, existem so na migration `*_audit_logs_search_values`: o Prisma nao modela
/// indice de expressao, e o `migrate dev` nao os enxerga nem tenta remove-los. Nao os declare aqui. A consulta
/// (`listAuditLogsService`) repete a expressao igual; mudar uma exige mudar a outra, senao o indice deixa de ser usado.
model AuditLog {
  id            String      @id @default(uuid(7))
  companyId     String
  module        AuditModule
  entity        String
  entityId      String?
  action        AuditAction
  description   String?
  before        Json?
  after         Json?
  changedFields String[]    @default([])
  userId        String?
  requestId     String?
  ip            String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@index([userId])
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "audit_logs_description_trgm_idx")
  @@index([entityId(ops: raw("gin_trgm_ops"))], type: Gin, map: "audit_logs_entityId_trgm_idx")
  @@map("audit_logs")
}
