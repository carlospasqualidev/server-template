{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true
  },
  "include": ["src", "prisma", "scripts", "prisma.config.ts", "vitest.config.ts"],
  // src/api, lib e prisma/seeds sao a estrutura antiga (substituida por src/modules, src/lib e prisma/seed.ts).
  // Apague essas pastas e remova-as daqui.
  "exclude": ["node_modules", "dist", "src/api", "prisma/seeds"]
}
