# Servidor
PORT=8080
# development | test | production
NODE_ENV=development
PROJECT_NAME=Server
# Rótulo livre enviado ao log de erros (padrão: NODE_ENV)
PROJECT_ENVIRONMENT=Local
# fatal | error | warn | info | debug | trace | silent (padrão: debug em dev, info em prod)
LOG_LEVEL=

# Banco (docker compose sobe este Postgres). A suíte de testes usa o mesmo servidor e credenciais, num banco
# temporário por execução (`temporary-int-*`), e só se o host for local; senão cai em localhost:5432 com aviso.
# Para outro Postgres local, exporte TEST_DATABASE_URL (como faz o CI).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/server_template"

# Sessão (cookie HTTP-only com JWT)
JWT_SECRET="change-me-to-a-long-random-string"
SESSION_TTL_HOURS=12

# CORS: origens permitidas, separadas por vírgula. `*` é recusado na subida: a sessão vai em cookie (credenciais),
# e com `*` o navegador bloqueia a resposta. Liste cada origem.
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# Retenção da trilha de auditoria: o servidor anonimiza e depois apaga os eventos vencidos, todo dia às 03:00 UTC,
# pelos prazos de cada empresa (configurações `audit.*`). true | false (padrão: true; sempre desligada em teste).
# Desligue quando um cron externo rodar `npm run audit:retention` (ou `node dist/scripts/runAuditRetention.js`).
AUDIT_RETENTION_ENABLED=

# Log externo de erros 500 (opcional; só dispara em produção)
ERROR_LOG_URL=

# Upload para S3 (opcional; sem as quatro variáveis a rota de upload responde 503)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_BUCKET_REGION=
