# Servidor
PORT=8080
# development | test | production
NODE_ENV=development
PROJECT_NAME=Server
# Rótulo livre enviado ao log de erros (padrão: NODE_ENV)
PROJECT_ENVIRONMENT=Local
# fatal | error | warn | info | debug | trace | silent (padrão: debug em dev, info em prod)
LOG_LEVEL=

# Banco (docker compose sobe este Postgres; a suíte usa o banco `server_template_test` no mesmo servidor)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/server_template"

# Sessão (cookie HTTP-only com JWT)
JWT_SECRET="change-me-to-a-long-random-string"
SESSION_TTL_HOURS=12

# CORS: origens permitidas, separadas por vírgula
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# Log externo de erros 500 (opcional; só dispara em produção)
ERROR_LOG_URL=

# Upload para S3 (opcional; sem as quatro variáveis a rota de upload responde 503)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_BUCKET_REGION=
