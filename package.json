{
  "name": "server-template",
  "version": "1.0.0",
  "private": true,
  "description": "Template de API REST com Fastify, Prisma e Zod",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "openapi:export": "tsx scripts/exportOpenApi.ts",
    "clean": "node -e \"const{rmSync}=require('node:fs');for(const p of ['dist','coverage','src/generated']){rmSync(p,{recursive:true,force:true});console.log('removed',p);}\"",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1022.0",
    "@aws-sdk/lib-storage": "3.1022.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.5",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "bcrypt": "6.0.0",
    "dotenv": "17.4.0",
    "fastify": "5.8.4",
    "fastify-type-provider-zod": "7.0.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.5.0",
    "@types/pg": "8.20.0",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-security": "4.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.1",
    "prisma": "7.6.0",
    "tsc-alias": "1.9.5",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "std-env": "4.2.0"
  }
}
